{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://acx.dev/schema/0.1/receipt.json","title":"ACX Execution Receipt 0.1","type":"object","required":["acx","receiptId","capability","provider","status","issuedAt","requestHash"],"properties":{"acx":{"const":"0.1"},"receiptId":{"type":"string"},"capability":{"type":"string"},"provider":{"type":"string"},"status":{"enum":["accepted","succeeded","failed","cancelled"]},"issuedAt":{"type":"string","format":"date-time"},"requestHash":{"type":"string"},"resultHash":{"type":"string"},"cost":{"type":"object"},"effects":{"type":"array","items":{"type":"string"}},"recovery":{"type":"object"},"proof":{"type":"object"},"signature":{"type":"object","required":["profile","algorithm","encoding","digestProfile","publicKey","keyId","value"],"properties":{"profile":{"enum":["org.jrip.receipt-ed25519-v1","org.jrip.receipt-ed25519-v2"]},"algorithm":{"const":"Ed25519"},"encoding":{"const":"hex"},"digestProfile":{"enum":["org.jrip.serde-json-v1","org.jrip.jcs-safe-v1"]},"publicKey":{"type":"string","pattern":"^[0-9a-f]{64}$"},"keyId":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"value":{"type":"string","pattern":"^[0-9a-f]{128}$"}},"additionalProperties":false,"allOf":[{"if":{"properties":{"profile":{"const":"org.jrip.receipt-ed25519-v1"}}},"then":{"properties":{"digestProfile":{"const":"org.jrip.serde-json-v1"}}},"else":{"properties":{"digestProfile":{"const":"org.jrip.jcs-safe-v1"}}}}]}},"additionalProperties":false}
